# Nightwatch Backup systemd service template.
# Rendered by 'nightwatchctl schedule enable' (or 'nightwatchctl schedule render').
[Unit]
Description=Nightwatch Backup
After=network-online.target local-fs.target

[Service]
Type=oneshot
Environment=@SD_ENV_CONFIG@
Environment=@SD_ENV_STATE@
Environment=@SD_ENV_LOG@
ExecStart=@SD_ENGINE@ -q -c @SD_CONFIG@
Nice=10
IOSchedulingClass=idle
