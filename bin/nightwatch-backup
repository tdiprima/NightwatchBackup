#!/usr/bin/env bash
# Nightwatch Backup: Data Preservation Protocol
# MIT License

set -Eeuo pipefail
shopt -s inherit_errexit 2>/dev/null || true

# Ensure Homebrew-installed tools are on PATH when run under cron/launchd
export PATH="/usr/local/bin:/opt/homebrew/bin:$PATH"

# ----------------------------
# Globals + defaults
# ----------------------------
VERSION="1.0.0"
APP="nightwatch-backup"

CONFIG_FILE="${CONFIG_FILE:-/etc/nightwatch-backup/nightwatch-backup.conf}"
STATE_DIR="${STATE_DIR:-/var/lib/nightwatch-backup}"
LOG_DIR="${LOG_DIR:-/var/log/nightwatch-backup}"
LOCK_FILE="${LOCK_FILE:-/var/lock/nightwatch-backup.lock}"

RUN_ID="$(date -u +%Y%m%dT%H%M%SZ)-$$"
HOSTNAME_FQDN="$(hostname -f 2>/dev/null || hostname)"

# ----------------------------
# Logging
# ----------------------------
mkdir -p "$STATE_DIR" "$LOG_DIR"
LOG_FILE="${LOG_FILE:-$LOG_DIR/${APP}.log}"

log() {
  local level="$1"; shift
  local ts; ts="$(date -u +'%Y-%m-%dT%H:%M:%SZ')"
  printf '%s [%s] [%s] %s\n' "$ts" "$level" "$RUN_ID" "$*" | tee -a "$LOG_FILE" >&2
}

die() { log "ERROR" "$*"; exit 1; }

# ----------------------------
# Cleanup + trap
# ----------------------------
cleanup() {
  local code=$?
  rm -f "$LOCK_FILE" 2>/dev/null || true
  if [[ $code -ne 0 ]]; then
    log "ERROR" "Run failed with exit code $code"
  else
    log "INFO" "Run completed successfully"
  fi
}
trap cleanup EXIT

on_err() {
  local line="$1" cmd="$2"
  log "ERROR" "Unhandled error at line $line: $cmd"
}
trap 'on_err "${LINENO}" "${BASH_COMMAND}"' ERR

# ----------------------------
# Locking (avoid overlapping runs)
# ----------------------------
acquire_lock() {
  if ( set -o noclobber; echo "$$" > "$LOCK_FILE" ) 2>/dev/null; then
    log "INFO" "Lock acquired"
  else
    local holder
    holder="$(cat "$LOCK_FILE" 2>/dev/null || true)"
    die "Another run is active (lock: $LOCK_FILE holder: ${holder:-unknown})"
  fi
}

# ----------------------------
# Config loading + validation
# ----------------------------

# sha256 command detection (sha256sum on Linux, shasum -a 256 on macOS)
SHA256_CMD=()

detect_sha256_cmd() {
  if command -v sha256sum >/dev/null 2>&1; then
    SHA256_CMD=(sha256sum)
  elif command -v shasum >/dev/null 2>&1; then
    SHA256_CMD=(shasum -a 256)
  else
    die "No SHA-256 utility found (need sha256sum or shasum)"
  fi
}

load_config() {
  [[ -f "$CONFIG_FILE" ]] || die "Missing config: $CONFIG_FILE"
  # shellcheck disable=SC1090
  source "$CONFIG_FILE"
}

require_cmd() {
  command -v "$1" >/dev/null 2>&1 || die "Missing required command: $1"
}

validate_config() {
  : "${BACKUP_NAME:?Must set BACKUP_NAME}"
  : "${BACKUP_ROOT:?Must set BACKUP_ROOT}"
  [[ ${#SOURCES[@]} -eq 0 ]] && die "Must set SOURCES array with at least one path"

  mkdir -p "$BACKUP_ROOT"

  require_cmd rsync
  require_cmd find
  detect_sha256_cmd
}

# ----------------------------
# rsync flag detection
# ----------------------------
# macOS ships openrsync which does not support --acls (-A) or --xattrs (-X).
# Probe once and build a base flag set that works on any platform.
_rsync_base_flags=()
_rsync_flags_detected=0

detect_rsync_flags() {
  [[ $_rsync_flags_detected -eq 1 ]] && return
  _rsync_base_flags=(-aH --numeric-ids --delete --info=stats2,progress2
                     --partial "--partial-dir=.rsync-partial")
  local help; help="$(rsync --help 2>&1 || true)"
  if printf '%s\n' "$help" | grep -qw -- '--acls';   then _rsync_base_flags+=(-A); fi
  if printf '%s\n' "$help" | grep -qw -- '--xattrs'; then _rsync_base_flags+=(-X); fi
  _rsync_flags_detected=1
}

# ----------------------------
# Utilities
# ----------------------------
retry() {
  # retry <attempts> <sleep_seconds> -- <cmd...>
  local attempts="$1" sleep_s="$2"; shift 2
  local n=1
  while true; do
    if "$@"; then return 0; fi
    if [[ $n -ge $attempts ]]; then return 1; fi
    log "WARN" "Retry $n/$attempts failed; sleeping ${sleep_s}s: $*"
    sleep "$sleep_s"
    n=$((n+1))
  done
}

# ----------------------------
# Core steps
# ----------------------------
rsync_sources() {
  detect_rsync_flags
  local rsync_args=("${_rsync_base_flags[@]}")

  if [[ -n "${EXCLUDES_FILE:-}" && -f "${EXCLUDES_FILE:-}" ]]; then
    rsync_args+=(--exclude-from "$EXCLUDES_FILE")
  fi

  for src in "${SOURCES[@]}"; do
    [[ -e "$src" ]] || { log "WARN" "Source missing, skipping: $src"; continue; }
    local dest="${BACKUP_ROOT}/$(basename "$src")/"
    mkdir -p "$dest"
    log "INFO" "Syncing: $src -> $dest"
    retry "${RSYNC_RETRIES:-3}" "${RSYNC_RETRY_SLEEP:-5}" \
      rsync "${rsync_args[@]}" "$src/" "$dest" \
      || die "Rsync failed for source: $src"
  done
}

generate_checksums() {
  if [[ "${ENABLE_CHECKSUMS:-1}" -eq 1 ]]; then
    log "INFO" "Generating SHA256 checksums"
    (cd "$BACKUP_ROOT" && find . -type f ! -name "SHA256SUMS" -print0 \
      | xargs -0 "${SHA256_CMD[@]}" > SHA256SUMS) || die "Checksum generation failed"
  fi
}

verify_backup() {
  if [[ "${ENABLE_VERIFY:-1}" -eq 1 ]]; then
    log "INFO" "Verifying checksums"
    (cd "$BACKUP_ROOT" && "${SHA256_CMD[@]}" -c SHA256SUMS) || die "Verification failed"
  fi
}

remote_sync_optional() {
  if [[ "${ENABLE_REMOTE_SYNC:-0}" -eq 1 ]]; then
    : "${REMOTE_TARGET:?Set REMOTE_TARGET like user@host:/path}"
    log "INFO" "Remote sync -> ${REMOTE_TARGET}"
    detect_rsync_flags
    retry 3 10 rsync "${_rsync_base_flags[@]}" "$BACKUP_ROOT/" "${REMOTE_TARGET%/}/" \
      || die "Remote sync failed"
  fi
}

notify_optional() {
  if [[ "${ENABLE_EMAIL:-0}" -eq 1 ]]; then
    : "${EMAIL_TO:?Set EMAIL_TO}"
    local subj="[${APP}] backup ${BACKUP_NAME} on ${HOSTNAME_FQDN} (${RUN_ID})"
    local body="Backup completed. Destination: ${BACKUP_ROOT}"
    if command -v mail >/dev/null 2>&1; then
      printf '%s\n' "$body" | mail -s "$subj" "$EMAIL_TO" || log "WARN" "Email failed"
    else
      log "WARN" "Email enabled but 'mail' not found"
    fi
  fi
}

# ----------------------------
# CLI
# ----------------------------
usage() {
  cat <<EOF
${APP} ${VERSION}
Usage:
  ${APP} run
  ${APP} verify [path]
  ${APP} list
  ${APP} version

Config:
  CONFIG_FILE=$CONFIG_FILE
EOF
}

cmd_run() {
  acquire_lock
  load_config
  validate_config

  log "INFO" "Starting backup: name=${BACKUP_NAME} dest=${BACKUP_ROOT}"
  rsync_sources
  generate_checksums
  verify_backup
  remote_sync_optional
  notify_optional
}

cmd_verify() {
  local dir="${1:-}"
  load_config
  dir="${dir:-$BACKUP_ROOT}"
  [[ -f "$dir/SHA256SUMS" ]] || die "No SHA256SUMS in $dir"
  detect_sha256_cmd
  (cd "$dir" && "${SHA256_CMD[@]}" -c SHA256SUMS) || exit 2
  log "INFO" "Verification ok: $dir"
}

cmd_list() {
  load_config
  ls -1d "${BACKUP_ROOT}"/*/  2>/dev/null || true
}

main() {
  local cmd="${1:-}"
  case "$cmd" in
    run)     shift; cmd_run "$@";;
    verify)  shift; cmd_verify "$@";;
    list)    shift; cmd_list "$@";;
    version) echo "$VERSION";;
    ""|-h|--help) usage;;
    *) usage; exit 2;;
  esac
}

main "$@"
